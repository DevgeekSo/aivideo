{
  "rewrites": [
    {
      "source": "/api/tts",
      "destination": "https://translate.google.com/translate_tts"
    },
    {
      "source": "/api/youdao",
      "destination": "https://dict.youdao.com/dictvoice"
    },
    {
      "source": "/api/did/(.*)",
      "destination": "https://api.d-id.com/$1"
    },
    {
      "source": "/api/anthropic/(.*)",
      "destination": "https://api.anthropic.com/$1"
    },
    {
      "source": "/api/openrouter/(.*)",
      "destination": "https://openrouter.ai/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
